{
  "id": "/agentes",
  "name": "Portal de agentes · UDES",
  "short_name": "Agentes UDES",
  "description": "El Portal de agentes de la Universidad de Santander: la bandeja, las conversaciones con las personas y los avisos, en el computador o en el celular.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/agentes",
  "scope": "/agentes",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "orientation": "natural",
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "background_color": "#f4f7fb",
  "theme_color": "#0a2d63",
  "categories": ["productivity"],
  "icons": [
    { "src": "/pilo-app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pilo-app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pilo-app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
