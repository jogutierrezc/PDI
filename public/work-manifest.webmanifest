{
  "id": "/work",
  "name": "Pilo at Work",
  "short_name": "Pilo at Work",
  "description": "El agente de IA para el trabajo en las oficinas de la Universidad de Santander. Solo para personas con un rol asignado.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/work",
  "scope": "/work",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "prefer_related_applications": false,
  "background_color": "#0a2d63",
  "theme_color": "#0a2d63",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/pilo-app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pilo-app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pilo-app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chat con Pilo", "url": "/work/chat", "icons": [{ "src": "/pilo-app/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Mi agenda", "url": "/work/agenda", "icons": [{ "src": "/pilo-app/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
